{
  "name": "@proj-airi/companion-core",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Local Companion Gateway for AIRI. It forwards OpenAI-compatible chat requests to one configured cloud provider.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./memory": "./src/memory/index.ts"
  },
  "bin": {
    "companion-core": "./src/bin/run.ts"
  },
  "scripts": {
    "start": "tsx ./src/bin/run.ts serve",
    "cli": "tsx ./src/bin/run.ts",
    "persona": "tsx ./eval/persona/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@moeru/std": "catalog:",
    "@proj-airi/server-sdk": "workspace:^",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@proj-airi/server-runtime": "workspace:^",
    "@types/node": "catalog:",
    "@xsai/stream-text": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
